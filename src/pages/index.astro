---
import "../components/GlobalStyles.astro";
import { Image } from "astro:assets";
import img1 from "../assets/img1.jpg";
import img2 from "../assets/img2.jpg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Converge</title>
  </head>
  <body style="overflow-y: hidden;">
    <div
      style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center;"
    >
      <div
        style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10px"
      >
        <div style="display: flex; gap: 20px">
          <Image src={img1} width={256} alt={""} />
          <Image src={img2} width={256} alt={""} />
        </div>
        <p>Play with your friends and try to converge!</p>
      </div>
      <div style="padding-bottom: 32px;">
        <a href="/privacy">Privacy policy</a>
      </div>
    </div>
  </body>
</html>
