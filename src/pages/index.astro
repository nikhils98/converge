---
import "../components/GlobalStyles.astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Converge</title>
  </head>
  <body style="overflow-y: hidden;">
    <div
      style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; padding: 32px"
    >
      <nav style="display: flex; flex-direction: row; gap: 16px">
        <a href="/">Home</a>
        <a href="/privacy">Privacy</a>
        <a href="mailto:nikhil.satiani@gmail.com">Contact</a>
      </nav>
      <div
        style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 10px"
      >
        <div>
          <h1 class="title">Converge</h1>
        </div>
        <div style="display: flex; gap: 20px">
          <img src="img1.jpg" width={256} alt={""} />
          <img src="img2.jpg" width={256} alt={""} />
        </div>
        <div>
          <p>Play with your friends and match words as quick as you can!</p>
        </div>
        <div style="padding: 32px">
          <a
            href="https://play.google.com/store/apps/details?id=com.fibonacci.converge"
            target="_blank"
            ><img
              src="get-it-on-google.png"
              alt="Get it on google"
              height="48px"
            /></a
          >
        </div>
      </div>
    </div>
  </body>
</html>
